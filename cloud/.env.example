# Copie URLs do painel Prisma Postgres. Não use URLs inventadas.
DATABASE_URL=
DIRECT_URL=
# Desenvolvimento: http://localhost:3000; produção: https://cronosjarvis.vercel.app
APP_ORIGIN=http://localhost:3000
# Gere localmente com crypto.randomBytes(32).toString('hex'). Nunca no desktop.
AUTH_SECRET=
OPENAI_API_KEY=
OPENAI_ALLOWED_MODELS=gpt-4.1-mini
OPENAI_VOICE_ENABLED=false
# Preços USD por milhão de tokens; conferir no provedor antes de configurar.
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=
# Somente CLI local: criar primeiro administrador e remover estas variáveis depois.
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=

# Spotify: somente Cloud. Não cole segredos no Electron ou em arquivos versionados.
SPOTIFY_CLIENT_ID=a075ad4ae29f41c5a3df8d2ff9c84972
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://cronosjarvis.vercel.app/api/integrations/spotify/callback
# 32 bytes aleatórios em hexadecimal (64 caracteres); guarde para descriptografar conexões.
SPOTIFY_TOKEN_ENCRYPTION_KEY=

# Optional sampled, content-free request/database summaries (disabled by default).
JARVIS_DB_METRICS=0
JARVIS_DB_METRICS_SAMPLE=0.1

# v6.3 publisher: server only; blank keeps publication disabled. No privileged key in Desktop.
CYRO_GITHUB_TOKEN=
CYRO_PUBLISHER_ORIGIN=
CYRO_PUBLISHER_SECRET=
# External service only: private local staging, behind TLS reverse proxy.
CYRO_UPLOAD_DIR=
