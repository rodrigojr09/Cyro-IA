{
  "name": "@jarvis/cloud",
  "version": "6.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "db:seed": "tsx prisma/seed.ts",
    "admin:bootstrap": "prisma generate && tsx scripts/bootstrap-admin.ts",
    "db:reset-users": "prisma generate && tsx scripts/reset-cloud.ts",
    "publisher:start": "tsx scripts/publisher-server.ts"
  },
  "dependencies": {
    "@jarvis/shared": "*",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "^17.2.3",
    "next": "16.4.2",
    "openai": "^6.0.0",
    "pg": "^8.16.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.3",
    "@types/node": "^22.19.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "author": {
    "name": "Rodrigo Junior",
    "email": "rodrigo.macia019@gmail.com",
