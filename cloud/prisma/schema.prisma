generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}
datasource db {
  provider = "postgresql"
}
enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}
enum UserStatus {
  ACTIVE
  DISABLED
}
enum LicenseStatus {
  ACTIVE
  SUSPENDED
}
model User {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(100)
  email String @unique @db.VarChar(254)
  passwordHash String?
  role Role @default(EMPLOYEE)
  status UserStatus @default(ACTIVE)
  managerId String? @db.Uuid
  manager User? @relation("ManagedUsers", fields: [managerId], references: [id], onDelete: Restrict)
  employees User[] @relation("ManagedUsers")
  monthlyTokenLimit Int @default(100000)
  cloudStorageLimitBytes Int @default(52428800)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdCodes ActivationCode[] @relation("CodeCreator")
  assignedCodes ActivationCode[] @relation("CodeAssignee")
  devices Device[]
  licenses License[]
  usage UsageLog[]
  audit AuditLog[]
  sessions Session[]
  budgets UsageBudget[]
  client Client?
  conversations Conversation[]
  spotify SpotifyConnection?
  spotifyTransactions SpotifyOAuthTransaction[]
  @@index([managerId, status])
}
model Client {
  id String @id @db.Uuid
  user User @relation(fields: [id], references: [id], onDelete: Restrict)
  maxDevices Int @default(2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  devices Device[]
  activationCodes ActivationCode[]
}
model SystemSettings {
  id String @id @default("global")
  intelligenceEnabled Boolean @default(true)
  maxOutputTokens Int @default(3500)
  updatedAt DateTime @updatedAt
}
model ActivationCode {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  createdById String @db.Uuid
  createdBy User @relation("CodeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedUserId String? @db.Uuid
  assignedUser User? @relation("CodeAssignee", fields: [assignedUserId], references: [id], onDelete: Restrict)
  assignedClient Client? @relation(fields: [assignedUserId], references: [id], onDelete: Restrict, map: "ActivationCode_client_fkey")
  expiresAt DateTime
  consumedAt DateTime?
  revokedAt DateTime?
  maxUses Int @default(1)
  uses Int @default(0)
  createdAt DateTime @default(now())
  @@index([createdById, expiresAt])
}
model Device {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  client Client @relation(fields: [userId], references: [id], onDelete: Restrict, map: "Device_client_fkey")
  deviceId String @unique @db.Uuid
  name String @db.VarChar(100)
  lastSeenAt DateTime @default(now())
  revokedAt DateTime?
  createdAt DateTime @default(now())
  licenses License[]
  sessions Session[]
  usage UsageLog[]
  @@index([userId, revokedAt])
  @@unique([id, userId])
}
model License {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  deviceId String @db.Uuid
  device Device @relation(fields: [deviceId, userId], references: [id, userId], onDelete: Restrict)
  status LicenseStatus @default(ACTIVE)
  expiresAt DateTime?
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@unique([userId, deviceId])
  @@index([deviceId, revokedAt])
}
model UsageLog {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  deviceId String @db.Uuid
  device Device @relation(fields: [deviceId, userId], references: [id, userId], onDelete: Restrict)
  model String
  inputTokens Int
  outputTokens Int
  estimatedCost Decimal? @db.Decimal(16, 8)
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model AuditLog {
  id String @id @default(uuid()) @db.Uuid
  actorId String? @db.Uuid
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  action String
  targetType String
  targetId String?
  metadata Json?
  createdAt DateTime @default(now())
  @@index([actorId, createdAt])
}
model Session {
  deviceId String? @db.Uuid
  device Device? @relation(fields: [deviceId, userId], references: [id, userId], onDelete: Cascade)
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
  @@index([deviceId])
}
model RateLimit {
  key String @id
  count Int @default(0)
  expiresAt DateTime
  @@index([expiresAt])
}
model UsageBudget {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  period String
  charged Int @default(0)
  reserved Int @default(0)
  @@id([userId, period])
}

// Only general conversations live here. Projects and their chats stay on device.
model Conversation {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot String? @db.VarChar(16)
  title String @db.VarChar(120)
  archived Boolean @default(false)
  summary String @default("")
  instructions String @default("") @db.VarChar(4000)
  createdAt DateTime @default(now())
  lastMessageAt DateTime?
  messages ChatMessage[]
  @@unique([userId, slot])
  @@index([userId, lastMessageAt])
}

model ChatMessage {
  id Int @id @default(autoincrement())
  conversationId String @db.Uuid
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId String @db.Uuid
  role String @db.VarChar(16)
  content String
  scope String @default("") @db.VarChar(32)
  localAttachmentCount Int @default(0)
  createdAt DateTime @default(now())
  @@unique([conversationId, requestId])
  @@index([conversationId, id])
}


model SpotifyConnection {
  id String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String @default("spotify")
  spotifyUserId String @unique @db.VarChar(128)
  displayName String @db.VarChar(200)
  scopes String[]
  accessToken String
  refreshToken String
  expiresAt DateTime
  status String @default("connected")
  refreshLeaseUntil DateTime?
  retryAt DateTime?
  connectedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SpotifyOAuthTransaction {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String @db.Uuid
  ticketHash String @unique
  stateHash String? @unique
  browserHash String?
  status String @default("pending")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([userId, expiresAt])
}
