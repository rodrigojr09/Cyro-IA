{
  "name": "cyro-desktop",
  "version": "8.0.1",
  "private": true,
  "engines": {
    "node": ">=24.11 <25"
  },
  "scripts": {
    "dev": "python tools/start_cloud.py",
    "build": "npm --prefix desktop run build",
    "test": "npm --prefix desktop test",
    "typecheck": "npm --prefix desktop run typecheck",
    "typecheck:desktop": "npm --prefix desktop run typecheck",
    "check:repository": "node tools/check_repository.cjs",
    "test:tools": "node --test tools/repository.test.cjs",
    "test:electron": "node tools/run_electron_smoke.cjs --all",
    "pretest:electron": "npm --prefix desktop run build",
    "check:v5": "npm run check:v6",
    "check:v6": "npm run check:repository && npm run test:tools && npm run typecheck && npm test && python -m unittest discover -s backend -p \"test_*.py\" && python -m unittest -q test_start test_start_local test_cloud_build test_build test_setup && npm run test:electron && npm run test:platform-tools",
    "package": "python tools/build_cloud_desktop.py",
    "check:v7": "npm run check:v6",
    "check:v8": "npm run check:v7",
    "test:platform-tools": "python -m unittest discover -s tools/platform -p \"test_*.py\""
  },
  "author": {
    "name": "Rodrigo Junior",
    "email": "rodrigo.macia019@gmail.com",
    "url": "https://github.com/rodrigojr09"
  },
  "homepage": "https://github.com/rodrigojr09/Cyro-IA",
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-unique-id": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lucide": "^1.60.0",
    "marked": "^18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "global-agent": "4.1.3"
  }
}
