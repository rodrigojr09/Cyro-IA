{
  "appId": "com.jarvis.assistant",
  "productName": "Cyro IA",
  "asar": true,
  "directories": {
    "output": "../release/v6"
  },
  "files": [
    "scripts/app/main.js",
    "scripts/app/preload.js",
    "scripts/app/portable-paths.js",
    "scripts/app/window-state.js",
    "scripts/session/readiness.js",
    "scripts/session/cloud.js",
    "scripts/session/backend-runtime.js",
    "scripts/session/encrypted-state.js",
    "scripts/session/initial-settings.js",
    "scripts/session/ai-config.js",
    "scripts/clipboard/manager.js",
    "scripts/clipboard/service.js",
    "scripts/attachment/main.js",
    "scripts/writer/ipc.js",
    "scripts/quick/controller.js",
    "scripts/quick/core.js",
    "scripts/quick/preload.js",
    "scripts/integrations/spotify-ipc.js",
    "scripts/chat/local-stream.js",
    "dist/main.js",
    "dist/login.js",
    "dist/quick.js",
    "index.html",
    "login.html",
    "quick.html",
    "app.css",
    "login.css",
    "quick.css",
    "clipboard.css",
    "writer.css",
    "package.json",
    "electron/main.cjs",
    "electron/cloud-config.json",
    "assets/spotify-white.svg",
    "assets/spotify-black.svg",
    "styles/**",
    "dist/*.LEGAL.txt",
    "electron/runtime-files.json",
    "!tests/**",
    "!node_modules/**",
    "dist/highlight.css",
    "scripts/updates/protocol.js",
    "scripts/updates/installer.js",
    "scripts/updates/client.js",
    "scripts/updates/ipc.js"
  ],
  "extraResources": [
    {
      "from": "../build/v6/backend/jarvis-backend",
      "to": "backend",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "../build/icons/jarvis.png",
      "to": "jarvis.png"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "../build/icons/jarvis.ico"
  },
  "nsis": {
    "artifactName": "Cyro-IA-Setup-${version}.exe",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false
  },
  "copyright": "Copyright © 2026 Rodrigo Junior",
  "executableName": "JARVIS",
  "beforeBuild": "./scripts/app/bundle-packaging.cjs"
}
