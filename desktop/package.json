{
  "name": "jarvis-desktop",
  "version": "6.0.1",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test attachments.test.js quick-renderer.test.js session.test.js security.test.js workspace.test.js scope.test.js ui.test.js quick.test.js backend-runtime.test.js package-output.test.js ai-config.test.js portable-paths.test.js encrypted-state.test.js services/cloud.test.js services/local-stream.test.js clipboard.test.js clipboard-service.test.js clipboard-ui.test.js writer-ui.test.js writer-ipc.test.js integration-catalog.test.js spotify.test.js",
    "test:electron": "node ../tools/run_electron_smoke.cjs smoke.cjs",
    "build": "node build.cjs",
    "typecheck": "tsc -p tsconfig.integrations.json",
    "prestart": "npm run build",
    "pretest": "npm run build",
    "pretest:electron": "npm run build",
    "test:quick": "node ../tools/run_electron_smoke.cjs quick-smoke.cjs",
    "format": "prettier --write \"*.js\" \"*.ts\" \"*.cjs\" \"*.html\" \"*.css\" \"styles/*.css\" \"*.json\"",
    "format:check": "prettier --check \"*.js\" \"*.ts\" \"*.cjs\" \"*.html\" \"*.css\" \"styles/*.css\" \"*.json\"",
    "package": "npm run build && electron-builder --config electron/builder.json --win --publish never",
    "test:cloud-electron": "node ../tools/run_electron_smoke.cjs cloud-smoke.cjs",
    "test:session-electron": "node ../tools/run_electron_smoke.cjs session-smoke.cjs",
    "test:clipboard": "node ../tools/run_electron_smoke.cjs clipboard-smoke.cjs",
    "pretest:clipboard": "npm run build",
    "test:spotify": "node ../tools/run_electron_smoke.cjs spotify-smoke.cjs",
    "pretest:spotify": "npm run build",
    "test:writer": "node ../tools/run_electron_smoke.cjs writer-smoke.cjs",
    "pretest:writer": "npm run build"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lucide": "^1.60.0",
    "marked": "^18.1.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "description": "Assistente desktop com projetos, memória e Quick Chat",
  "author": {
    "name": "Rodrigo Junior",
    "email": "rodrigo.macia019@gmail.com",
    "url": "https://github.com/rodrigojr09"
  },
  "homepage": "https://github.com/rodrigojr09"
}
