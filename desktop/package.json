{
  "name": "jarvis-desktop",
  "version": "1.0.0",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test security.test.js workspace.test.js scope.test.js ui.test.js quick.test.js backend-runtime.test.js package-output.test.js",
    "test:electron": "electron smoke.cjs",
    "build": "node build.cjs",
    "prestart": "npm run build",
    "pretest": "npm run build",
    "pretest:electron": "npm run build",
    "test:quick": "electron quick-smoke.cjs",
    "format": "prettier --write \"*.js\" \"*.cjs\" \"*.html\" \"*.css\" \"styles/*.css\" \"*.json\"",
    "format:check": "prettier --check \"*.js\" \"*.cjs\" \"*.html\" \"*.css\" \"styles/*.css\" \"*.json\"",
    "package": "npm run build && node package.cjs"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lucide": "^1.60.0",
    "marked": "^18.1.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "description": "Assistente desktop com projetos, mem\u00f3ria e Quick Chat",
  "author": "JARVIS"
}
