{
  "name": "jarvis-desktop",
  "version": "6.3.1",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/unit/*.test.js tests/renderer/*.test.cjs",
    "test:electron": "node ../tools/run_electron_smoke.cjs smoke.cjs",
    "build": "node build.cjs",
    "typecheck": "tsc -p tsconfig.integrations.json",
    "prestart": "npm run build",
    "pretest": "npm run build",
    "pretest:electron": "npm run build",
    "test:quick": "node ../tools/run_electron_smoke.cjs quick-smoke.cjs",
    "format": "prettier --write \"scripts/**/*.{js,jsx,ts,cjs}\" \"tests/**/*.{js,cjs}\" \"*.{cjs,html,css,json}\" \"styles/*.css\"",
    "format:check": "prettier --check \"scripts/**/*.{js,jsx,ts,cjs}\" \"tests/**/*.{js,cjs}\" \"*.{cjs,html,css,json}\" \"styles/*.css\"",
    "package": "npm run build && electron-builder --config electron/builder.json --win --publish never",
    "test:cloud-electron": "node ../tools/run_electron_smoke.cjs cloud-smoke.cjs",
    "test:session-electron": "node ../tools/run_electron_smoke.cjs session-smoke.cjs",
    "test:clipboard": "node ../tools/run_electron_smoke.cjs clipboard-smoke.cjs",
    "pretest:clipboard": "npm run build",
    "test:spotify": "node ../tools/run_electron_smoke.cjs spotify-smoke.cjs",
    "pretest:spotify": "npm run build",
    "test:writer": "node ../tools/run_electron_smoke.cjs writer-smoke.cjs",
    "pretest:writer": "npm run build"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "prettier": "3.9.10"
  },
  "dependencies": {
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-unique-id": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "lucide": "^1.60.0",
    "marked": "^18.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "description": "Cyro IA: assistente desktop com projetos, memoria e Quick Chat",
  "author": {
    "name": "Rodrigo Junior",
    "email": "rodrigo.macia019@gmail.com",
    "url": "https://github.com/rodrigojr09"
  },
  "homepage": "https://github.com/rodrigojr09/Cyro-IA"
}
